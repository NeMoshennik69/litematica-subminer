{
  "schemaVersion": 1,
  "id": "litematica-subterranean-miner",
  "name": "SubMiner",
  "version": "${version}",
  "description": "Client-side mod that clears a user-defined underground zone layer by layer in a snake pattern. Press K for settings, J to start/stop.",
  "authors": [ "NeMoshennik69" ],
  "license": "MIT",
  "contact": {
    "sources": "https://github.com/NeMoshennik69/litematica-subminer"
  },
  "environment": "client",
  "entrypoints": {
    "client": [ "com.example.litematicaaddon.ModInit" ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
